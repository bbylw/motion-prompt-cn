{
  "name": "motion-prompt",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun --bun run astro dev",
    "build": "bun --bun run astro build",
    "preview": "bun --bun run astro preview",
