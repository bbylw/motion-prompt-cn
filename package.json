  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.4",
    "@types/bun": "1.4.4",
    "tailwindcss": "^4.3.4",
    "typescript": "^6"
  }
}