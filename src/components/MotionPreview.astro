---
import PreviewCanvas from './PreviewCanvas.astro';
import { catalogPacks } from '../data/catalog';

interface Props {
  pack?: string;
  index?: number;
  label?: string;
}

const { pack = 'motion', index = 0, label = '' } = Astro.props;
const size = catalogPacks.find((item) => item.id === pack) ?? catalogPacks[0];
---

<div class="group relative rounded-xl overflow-hidden bg-ink-900 border border-white/[0.06] hover:border-white/[0.12] transition-all duration-150">
  <div class="relative overflow-hidden">
    <PreviewCanvas
      pack={pack}
      index={index}
      width={size.width}
      height={size.height}
      label={label ? `${label} 动效示例` : ''}
    />
    <!-- Bottom gradient overlay for label readability -->
    <div class="absolute bottom-0 left-0 right-0 h-12 bg-gradient-to-t from-ink-950/80 to-transparent pointer-events-none"></div>
  </div>
  {label && (
    <div class="absolute bottom-2.5 left-3 text-[10px] font-mono text-white/50">
      {label}
    </div>
  )}
</div>
