---
import Icon from './Icon.astro';
import { siteStats, withBase } from '../data/site';
---

<footer class="border-t border-white/[0.06] bg-ink-950 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
      <!-- Brand -->
      <div class="md:col-span-5">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-8 h-8 rounded-lg bg-accent flex items-center justify-center">
            <Icon name="play" size={14} class="text-ink-950 ml-0.5" strokeWidth={2.5} />
          </div>
          <span class="font-display font-semibold text-white text-lg">Motion Prompt</span>
        </div>
        <p class="text-sm text-white/60 leading-relaxed max-w-sm mb-6">
          一套为「你让 AI 做的那些事」而准备的名称库。{siteStats.total} 个名称，{siteStats.packCount} 组分类，配动态示例、含义说明与提示词。让全世界有更多创意总监，与 AI 一起做出出色的作品。
        </p>
        <div class="flex items-center gap-2">
          <a
            href="https://github.com/showheyohtaki/motion-prompt"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2.5 rounded-lg bg-white/[0.04] text-white/60 hover:text-white hover:bg-white/[0.08] transition-all duration-150"
            aria-label="GitHub"
          >
            <Icon name="github" size={16} strokeWidth={1.5} />
          </a>
          <a
            href="https://x.com/showheyohtaki"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2.5 rounded-lg bg-white/[0.04] text-white/60 hover:text-white hover:bg-white/[0.08] transition-all duration-150"
            aria-label="X"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div class="md:col-span-2">
        <h4 class="text-xs font-semibold text-white/50 uppercase tracking-wider mb-4">导航</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href={withBase("/")} class="text-white/60 hover:text-white transition-colors duration-150">首页</a></li>
          <li><a href={`${withBase("/")}#usage`} class="text-white/60 hover:text-white transition-colors duration-150">使用方式</a></li>
          <li><a href={withBase("/docs")} class="text-white/60 hover:text-white transition-colors duration-150">文档</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div class="md:col-span-3">
        <h4 class="text-xs font-semibold text-white/50 uppercase tracking-wider mb-4">资源</h4>
        <ul class="space-y-2.5 text-sm">
          <li><a href="https://github.com/showheyohtaki/motion-prompt" target="_blank" rel="noopener noreferrer" class="text-white/60 hover:text-white transition-colors duration-150">GitHub 仓库</a></li>
          <li><a href="https://showheyohtaki.github.io/motion-prompt/" target="_blank" rel="noopener noreferrer" class="text-white/60 hover:text-white transition-colors duration-150">动态图库</a></li>
          <li><a href="https://showheyohtaki.github.io/motion-prompt/found.html" target="_blank" rel="noopener noreferrer" class="text-white/60 hover:text-white transition-colors duration-150">投稿案例</a></li>
          <li><a href="https://github.com/showheyohtaki/motion-prompt/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener noreferrer" class="text-white/60 hover:text-white transition-colors duration-150">参与贡献</a></li>
        </ul>
      </div>

      <!-- License -->
      <div class="md:col-span-2">
        <h4 class="text-xs font-semibold text-white/50 uppercase tracking-wider mb-4">许可</h4>
        <p class="text-sm text-white/60 leading-relaxed">
          MIT License<br />© 2026 Shohei Ohtaki
        </p>
        <p class="text-xs text-white/50 mt-3">
          允许商业使用
        </p>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-white/[0.06] flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-white/50">
        Motion Prompt — 让全世界有更多创意总监
      </p>
      <div class="flex items-center gap-2 text-xs text-white/50">
        <Icon name="award" size={12} strokeWidth={1.5} />
        <span>简体中文版 · 基于官方文档构建</span>
      </div>
    </div>
  </div>
</footer>
