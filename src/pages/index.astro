---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import MotionPreview from '../components/MotionPreview.astro';
import { packs, usageMethods } from '../data/packs';
import { catalogElements } from '../data/catalog';
import { siteStats, packRange, packExamples, marqueeNames, storyNames, withBase } from '../data/site';

const showcaseIndices = [0, 1, 3, 4, 5, 6];
const heroStats = [
  { value: String(siteStats.total), label: '名称总数', sub: `${siteStats.packCount} 组 × ${siteStats.perPack} 个` },
  { value: String(siteStats.packCount), label: '分组', sub: '各有自己的观感' },
  { value: 'MIT', label: '开源许可', sub: '允许商业使用' },
];
---

<BaseLayout title="Motion Prompt — 为 AI 而准备的动效名称库">
  <Navbar />

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden pt-28 pb-14 lg:pt-36 lg:pb-20">
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute -top-32 right-[6%] w-[520px] h-[420px] bg-accent/[0.07] rounded-full blur-[130px]"></div>
        <div class="absolute inset-0 hero-grid"></div>
        <div class="absolute inset-x-0 bottom-0 h-px bg-white/[0.06]"></div>
      </div>

      <div class="relative max-w-6xl mx-auto px-6">
        <div class="flex flex-wrap items-center gap-3 mb-10 font-mono text-[11px] tracking-[0.16em] uppercase text-white/55 stagger-item">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          <span>Motion Prompt / 2026</span>
          <span class="hidden sm:block w-8 h-px bg-white/15"></span>
          <span class="text-white/50">{siteStats.total} names · {siteStats.packCount} packs</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
          <div class="lg:col-span-8">
            <h1 class="text-display text-[1.75rem] sm:text-5xl lg:text-[3rem] xl:text-[3.25rem] leading-[1.22] sm:leading-[1.18] text-white mb-7 stagger-item">
              为「你让 AI 做的<span class="whitespace-nowrap">那些事」</span><br class="hidden xl:block" />而准备的名称库
            </h1>

            <p class="text-body text-white/65 text-base md:text-lg mb-9 stagger-item">
              每个名称都配有一段动态示例、一行含义说明，以及一个如何向 AI 提出需求的示例。涵盖动效运动、镜头运动、UI 组件、落地页效果与照片观感。
            </p>

            <div class="flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center gap-3 stagger-item">
              <a
                href={withBase("/docs")}
                class="inline-flex items-center justify-center px-7 py-3.5 rounded-xl bg-accent text-ink-950 font-semibold hover:bg-accent-hover transition-colors duration-150 press w-full sm:w-auto"
              >
                浏览完整文档
              </a>
              <a
                href="#usage"
                class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-white font-medium hover:bg-white/[0.08] hover:border-white/[0.16] transition-colors duration-150 press w-full sm:w-auto"
              >
                查看使用方式
              </a>
            </div>
          </div>

          <div class="lg:col-span-4 lg:pt-2">
            <div class="text-[10px] font-mono tracking-[0.18em] uppercase text-white/50 mb-4">At a glance</div>
            <div class="grid grid-cols-3 lg:grid-cols-1 divide-x lg:divide-x-0 lg:divide-y divide-white/[0.08] border-y border-white/[0.08]">
              {heroStats.map((stat) => (
                <div class="px-3 py-4 lg:px-0 lg:py-5 flex flex-col lg:flex-row lg:items-end lg:justify-between gap-1 lg:gap-4">
                  <div>
                    <div class="text-[10px] font-mono uppercase tracking-[0.14em] text-white/55">{stat.label}</div>
                    <div class="text-[11px] text-white/65 mt-1 hidden lg:block">{stat.sub}</div>
                  </div>
                  <div class="font-display text-2xl lg:text-4xl font-semibold text-white tabular-nums">{stat.value}</div>
                </div>
              ))}
            </div>
            <div class="hidden lg:flex mt-6 pt-4 border-t border-white/[0.08] items-center justify-between font-mono text-[10px] tracking-[0.14em] uppercase text-white/50">
              <span>Catalog range</span>
              <span>001 — {siteStats.total}</span>
            </div>
          </div>
        </div>

        <div class="mt-16 hidden lg:flex items-center gap-3 text-[10px] font-mono tracking-[0.2em] uppercase text-white/50">
          <span class="w-px h-8 bg-white/10"></span>
          <span>Scroll to explore</span>
        </div>
      </div>
    </section>

    <!-- Live motion previews -->
    <section class="py-16 lg:py-20 border-b border-white/[0.06]">
      <div class="max-w-6xl mx-auto px-6">
        <div class="section-eyebrow">
          <span class="section-eyebrow__index">01</span>
          <span>动态示例 / Live cells</span>
          <span class="section-eyebrow__rule"></span>
          <span class="section-eyebrow__meta">6 / {siteStats.total}</span>
        </div>

        <div class="mb-9 flex flex-col md:flex-row md:items-end md:justify-between gap-5">
          <div class="max-w-xl">
            <h2 class="text-display text-3xl md:text-4xl text-white mb-3">看看这些名称长什么样</h2>
            <p class="text-body text-white/65 text-sm md:text-base">每一个名称都是一种可复现的运动语言。以下 6 个示例直接取自官方 Pack，按同一时间轴实时绘制。</p>
          </div>
          <a href={withBase("/docs")} class="inline-flex items-center text-sm text-white/65 hover:text-white transition-colors duration-150 shrink-0">
            查看全部 {siteStats.total} 个名称
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-7">
          {showcaseIndices.map((index) => (
            <MotionPreview
              pack="motion"
              index={index}
              label={`${catalogElements[index].name} ${catalogElements[index].nameEn}`}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Name ticker -->
    <section class="py-5 border-b border-white/[0.06] overflow-hidden marquee marquee-mask">
      <div class="flex whitespace-nowrap animate-marquee marquee-content">
        {[0, 1].map(() => (
          <div class="flex items-center gap-8 pr-8">
            {marqueeNames.map((name) => (
              <span class="flex items-center gap-3 text-[11px] text-white/55 font-mono tracking-[0.08em]">
                <span class="w-1 h-1 rounded-full bg-accent/60"></span>
                {name}
              </span>
            ))}
          </div>
        ))}
      </div>
    </section>

    <!-- Packs -->
    <section id="packs" class="py-20 lg:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="section-eyebrow">
          <span class="section-eyebrow__index">02</span>
          <span>八组分类 / Packs</span>
          <span class="section-eyebrow__rule"></span>
          <span class="section-eyebrow__meta">001 — {siteStats.total}</span>
        </div>

        <div class="mb-10 flex flex-col md:flex-row md:items-end md:justify-between gap-5">
          <div class="max-w-2xl">
            <h2 class="text-display text-4xl md:text-5xl text-white mb-4">每组 24 个名称</h2>
            <p class="text-body text-white/65">各有自己的观感与配色。一个分组要做对的是名称，而不是某种固定风格。</p>
          </div>
          <a href={withBase("/docs")} class="inline-flex items-center text-sm text-white/65 hover:text-white transition-colors duration-150 shrink-0">
            按编号浏览
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {packs.map((pack, i) => (
            <a
              href={`${withBase("/docs")}#${pack.id}`}
              class="group relative flex flex-col p-6 md:p-7 rounded-2xl bg-ink-900 border border-white/[0.06] hover:border-white/[0.14] transition-colors duration-200 card-shadow card-lift stagger-item"
              style={`animation-delay: ${i * 70}ms`}
            >
              <span class="absolute inset-x-6 top-0 h-px opacity-0 group-hover:opacity-100 transition-opacity duration-200" style={`background: linear-gradient(90deg, transparent, ${pack.color}, transparent)`}></span>

              <div class="flex items-start justify-between gap-4 mb-5">
                <span class="text-[11px] font-mono text-white/55 tracking-[0.1em]">{packRange(pack.id)}</span>
                <span class="w-1.5 h-1.5 rounded-full" style={`background-color: ${pack.color}`}></span>
              </div>

              <h3 class="font-display text-xl font-semibold text-white mb-1">{pack.name}</h3>
              <p class="text-[11px] text-white/55 font-mono mb-4">{pack.subtitle}</p>
              <p class="text-sm text-white/65 leading-relaxed mb-5">{pack.description}</p>

              <div class="mt-auto flex flex-col items-start md:flex-row md:items-end md:justify-between gap-3 md:gap-4">
                <div class="space-y-1.5">
                  {packExamples(pack.id).map((ex) => (
                    <div class="flex items-center gap-2 text-xs font-mono text-white/65">
                      <Icon name="zap" size={9} strokeWidth={2} class="text-accent" />
                      {ex}
                    </div>
                  ))}
                </div>
                <div class="flex flex-wrap gap-1.5 md:justify-end">
                  {pack.tags.slice(0, 3).map((tag) => (
                    <span class="px-2 py-0.5 text-[11px] rounded-md bg-white/[0.04] text-white/55">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Origin -->
    <section class="py-20 lg:py-24 border-y border-white/[0.06] bg-ink-900/40">
      <div class="max-w-6xl mx-auto px-6">
        <div class="section-eyebrow">
          <span class="section-eyebrow__index">03</span>
          <span>为什么做这个 / Origin</span>
          <span class="section-eyebrow__rule"></span>
          <span class="section-eyebrow__meta">Shohei Ohtaki</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
          <div class="lg:col-span-7">
            <h2 class="text-display text-3xl md:text-4xl text-white mb-8 pl-5 border-l-2 border-accent leading-snug">
              限制人们的不是缺乏想象力，而是不知道这种运动叫什么
            </h2>
            <div class="space-y-5 text-body text-white/65 text-[15px]">
              <p>我发布了几段短视频，给动效运动和镜头运动配上名称，接下来几天收到了大量评论。其中一条的大意是：一直限制着他们的并不是缺乏想象力，而是不知道这种运动叫什么。</p>
              <p>如果由熟悉各自领域的人，用多种语言，把「为了和 AI 良好协作所需的共同语言」整理成一套可供翻阅的库，那会非常有用。</p>
            </div>
            <div class="mt-8 flex items-center gap-3 text-xs font-mono text-white/55">
              <span class="w-8 h-px bg-white/15"></span>
              <span>大瀧 昌平 / 株式会社デイトラ</span>
            </div>
          </div>

          <div class="lg:col-span-5">
            <div class="text-[10px] font-mono uppercase tracking-[0.16em] text-white/50 mb-4">从库里随手挑四个</div>
            <div class="divide-y divide-white/[0.08] border-y border-white/[0.08]">
              {storyNames.map((item) => (
                <a href={`${withBase("/docs")}#${item.packId}`} class="flex items-center gap-4 py-4 hover:bg-white/[0.02] transition-colors duration-150">
                  <span class="font-mono text-xs text-accent w-10 shrink-0">#{item.id}</span>
                  <span class="flex-1 min-w-0">
                    <span class="block text-sm font-medium text-white truncate">{item.name}</span>
                    <span class="block text-[11px] font-mono text-white/55 truncate">{item.nameEn} · {item.pack}</span>
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Usage -->
    <section id="usage" class="py-20 lg:py-24">
      <div class="max-w-6xl mx-auto px-6">
        <div class="section-eyebrow">
          <span class="section-eyebrow__index">04</span>
          <span>使用方式 / Workflow</span>
          <span class="section-eyebrow__rule"></span>
          <span class="section-eyebrow__meta">3 paths</span>
        </div>

        <div class="mb-10 max-w-2xl">
          <h2 class="text-display text-4xl md:text-5xl text-white mb-4">三种方式，任选其一</h2>
          <p class="text-body text-white/65">无论你是用编程 AI、视频生成模型，还是写需求简报，都能用这些名称准确表达。</p>
        </div>

        <div class="divide-y divide-white/[0.08] border-y border-white/[0.08]">
          {usageMethods.map((method) => (
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 py-8 lg:py-10">
              <div class="lg:col-span-2 flex items-center gap-4 lg:flex-col lg:items-start lg:gap-3">
                <span class="font-display text-3xl font-semibold text-white/50 tabular-nums">0{method.number}</span>
                <span class="w-9 h-9 rounded-lg bg-accent/10 border border-accent/20 flex items-center justify-center text-accent shrink-0">
                  <Icon name={method.icon} size={16} strokeWidth={1.5} />
                </span>
              </div>

              <div class="lg:col-span-6">
                <h3 class="font-display text-xl font-semibold text-white mb-2">{method.title}</h3>
                <p class="text-sm text-white/65 leading-relaxed mb-5">{method.description}</p>
                <ol class="space-y-2">
                  {method.steps.map((step, i) => (
                    <li class="flex items-start gap-3 text-sm text-white/65">
                      <span class="font-mono text-[11px] text-accent mt-0.5 w-4 shrink-0">{i + 1}</span>
                      {step}
                    </li>
                  ))}
                </ol>
              </div>

              <div class="lg:col-span-4">
                {method.code ? (
                  <div class="p-4 rounded-xl bg-ink-900 border border-white/[0.08] font-mono text-xs text-white/65 overflow-x-auto">
                    <div class="flex items-center gap-2 mb-2 text-white/50">
                      <Icon name="terminal" size={11} strokeWidth={1.5} />
                      <span>terminal</span>
                    </div>
                    <code class="whitespace-pre-wrap break-all">{method.code}</code>
                  </div>
                ) : (
                  <div class="p-4 rounded-xl border border-dashed border-white/[0.08] text-xs text-white/55 leading-relaxed">
                    把提示词交给编程 AI，它会为你的领域生成同类的名称示例。
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 lg:py-24 border-t border-white/[0.06]">
      <div class="max-w-6xl mx-auto px-6">
        <div class="relative overflow-hidden">
          <div class="section-eyebrow">
            <span class="section-eyebrow__index">05</span>
            <span>开始 / Next step</span>
            <span class="section-eyebrow__rule"></span>
            <span class="section-eyebrow__meta">MIT licensed</span>
          </div>

          <div class="relative flex flex-col lg:flex-row lg:items-end lg:justify-between gap-10">
            <div>
              <h2 class="text-display text-3xl md:text-5xl text-white mb-5">挑一个名称，剩下的交给 AI</h2>
              <p class="text-body text-white/65 max-w-lg">打开名称库，挑选你想要的示例，发送给 AI。或者直接按编号 #001 到 #{siteStats.total} 提出请求。</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3 shrink-0">
              <a
                href={withBase("/docs")}
                class="inline-flex items-center justify-center px-8 py-4 rounded-xl bg-accent text-ink-950 font-semibold hover:bg-accent-hover transition-colors duration-150 press"
              >
                查看完整文档
              </a>
              <a
                href="https://github.com/showheyohtaki/motion-prompt"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-white/[0.04] border border-white/[0.08] text-white font-medium hover:bg-white/[0.08] hover:border-white/[0.16] transition-colors duration-150 press"
              >
                <Icon name="github" size={16} strokeWidth={1.5} />
                GitHub
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
